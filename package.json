{
  "name": "symphony-queue",
  "version": "0.1.0",
  "description": "Symphony orchestrator with an on-disk directory tree as the work tracker and OpenCode as the coding agent",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.17.15",
    "js-yaml": "^4.1.0",
    "liquidjs": "^10.21.1",
    "pino": "^9.6.0",
    "undici": "^7.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
